      "usage": "Structured match data for editions covered by the Cricsheet ICC Men's Cricket World Cup dataset."
    },
    {
      "provider": "ICC",
      "url": "https://www.icc-cricket.com/",
      "usage": "Tournament identity, official tournament records and statistical cross-checks."
    },
    {
      "provider": "CricketArchive",
      "url": "https://www.cricketarchive.com/",
      "usage": "Archived historical World Cup scorecards for 1975-1999. Used as the historical scorecard acquisition source and cross-checked against official tournament records."
    }
  ],

